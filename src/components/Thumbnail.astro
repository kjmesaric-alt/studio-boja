---
interface Props {
  slug: string;
  title: string;
  cover: string;
  hoverCombo: number; // 1–6
}

const { slug, title, cover, hoverCombo } = Astro.props;
---

<a
  href={`/${slug}/`}
  class="thumbnail"
  data-hover-combo={hoverCombo}
  style={`--thumb-bg: var(--hover-bg-${hoverCombo}); --thumb-text: var(--hover-text-${hoverCombo});`}
>
  <img class="thumbnail__img" src={cover} alt={title} loading="lazy" />
  <span class="thumbnail__title">{title}</span>
</a>

<style>
  .thumbnail {
    display: block;
    position: relative;
    width: var(--thumb-w);
    height: var(--thumb-h);
    overflow: hidden;
    flex-shrink: 0;
    background-color: var(--color-bg);
    transition: background-color 0.35s ease;
  }

  .thumbnail__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.35s ease;
  }

  .thumbnail__title {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-family);
    font-size: var(--font-size-base);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--thumb-text);
    opacity: 0;
    transition: opacity 0.35s ease;
    text-align: center;
    padding: 16px;
  }

  .thumbnail:hover {
    background-color: var(--thumb-bg);
  }

  .thumbnail:hover .thumbnail__img {
    opacity: 0;
  }

  .thumbnail:hover .thumbnail__title {
    opacity: 1;
  }
</style>
