---
const currentPath = Astro.url.pathname;
---

<nav class="nav">
  <a class="nav__name" href="/work/">studio boja.</a>

  <ul class="nav__menu" role="list">
    <li class="nav__item nav__item--dropdown">
      <a
        class:list={["nav__link", { "nav__link--active": currentPath.startsWith("/work/") }]}
        href="/work/"
        aria-haspopup="true"
        aria-expanded="false"
        id="work-menu-btn"
      >WORK</a>
      <ul class="nav__dropdown" role="list" aria-labelledby="work-menu-btn">
        <li><a class="nav__dropdown-link" href="/work/residential/">residential</a></li>
        <li><a class="nav__dropdown-link" href="/work/commercial/">commercial</a></li>
        <li><a class="nav__dropdown-link" href="/work/graphic/">graphic design</a></li>
      </ul>
    </li>
    <li class="nav__item">
      <a
        class:list={["nav__link", { "nav__link--active": currentPath.startsWith("/services/") }]}
        href="/services/"
      >SERVICES</a>
    </li>
    <li class="nav__item">
      <a
        class:list={["nav__link", { "nav__link--active": currentPath.startsWith("/about/") }]}
        href="/about/"
      >ABOUT</a>
    </li>
    <li class="nav__item">
      <a
        class:list={["nav__link", { "nav__link--active": currentPath.startsWith("/contact/") }]}
        href="/contact/"
      >CONTACT</a>
    </li>
  </ul>
</nav>

<style>
  .nav {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 32px var(--page-side-padding);
    background-color: var(--color-bg);
    position: relative;
    z-index: 100;
  }

  .nav__name {
    font-family: var(--font-family);
    font-size: var(--font-size-base);
    font-weight: 400;
    letter-spacing: var(--nav-name-letter-spacing);
    text-transform: lowercase;
    color: var(--color-text-nav);
  }

  .nav__menu {
    display: flex;
    align-items: baseline;
    gap: 48px;
    list-style: none;
  }

  .nav__item {
    position: relative;
  }

  .nav__link {
    font-family: var(--font-family);
    font-size: var(--font-size-base);
    font-weight: 400;
    letter-spacing: var(--nav-menu-letter-spacing);
    text-transform: uppercase;
    color: var(--color-text-nav);
  }

  .nav__dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    list-style: none;
    padding-top: 8px;
    min-width: 120px;
  }

  .nav__item--dropdown:hover .nav__dropdown,
  .nav__item--dropdown:focus-within .nav__dropdown {
    display: block;
  }

  .nav__dropdown-link {
    display: block;
    font-family: var(--font-family);
    font-size: var(--font-size-base);
    font-weight: 400;
    letter-spacing: 0;
    text-transform: lowercase;
    color: var(--color-text-nav);
    padding: 4px 0;
  }
</style>
