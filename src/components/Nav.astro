---
const currentPath = Astro.url.pathname;
const isWorkActive =
  currentPath === "/" ||
  currentPath.startsWith("/residential/") ||
  currentPath.startsWith("/commercial/") ||
  currentPath.startsWith("/graphic/");
---

<nav class="nav" transition:persist>
  <a class="nav__name" href="/">
    <span id="nav-word-studio">studio</span> <span id="nav-word-boja">boja.</span>
  </a>

  <ul class="nav__menu" role="list">
    <li class="nav__item nav__item--dropdown">
      <a
        class:list={["nav__link", { "nav__link--active": isWorkActive }]}
        href="/"
        aria-haspopup="true"
        aria-expanded="false"
        id="work-menu-btn"
      >WORK</a>
      <ul class="nav__dropdown" role="list" aria-labelledby="work-menu-btn">
        <li><a class="nav__dropdown-link" href="/residential/">residential</a></li>
        <li><a class="nav__dropdown-link" href="/commercial/">commercial</a></li>
        <li><a class="nav__dropdown-link" href="/graphic/">graphic design</a></li>
      </ul>
    </li>
    <li class="nav__item">
      <a
        class:list={["nav__link", { "nav__link--active": currentPath.startsWith("/services") }]}
        href="/services/"
        id="nav-services-link"
      >SERVICES</a>
    </li>
    <li class="nav__item">
      <a
        class:list={["nav__link", { "nav__link--active": currentPath.startsWith("/about") }]}
        href="/about/"
      >ABOUT</a>
    </li>
    <li class="nav__item">
      <a
        class:list={["nav__link", { "nav__link--active": currentPath.startsWith("/contact") }]}
        href="/contact/"
        id="nav-contact-link"
      >CONTACT</a>
    </li>
  </ul>
</nav>

<style>
  .nav {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 32px var(--page-side-padding);
    background-color: var(--page-bg, var(--color-bg));
    transition: background-color 0.35s ease;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .nav__name {
    font-family: var(--font-family);
    font-size: var(--font-size-brand);
    font-weight: 700;
    letter-spacing: var(--nav-name-letter-spacing);
    text-transform: lowercase;
    color: var(--page-nav-text, var(--color-text-nav));
    transition: color 0.35s ease;
  }

  .nav__menu {
    display: flex;
    align-items: baseline;
    gap: 78px;
    list-style: none;
  }

  .nav__item {
    position: relative;
  }

  .nav__link {
    font-family: var(--font-family);
    font-size: var(--font-size-base);
    font-weight: 400;
    letter-spacing: var(--nav-menu-letter-spacing);
    text-transform: uppercase;
    color: var(--page-nav-text, var(--color-text-nav));
    transition: color 0.35s ease;
  }

  .nav__dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    list-style: none;
    padding-top: 8px;
    min-width: 120px;
  }

  .nav__item--dropdown:hover .nav__dropdown,
  .nav__item--dropdown:focus-within .nav__dropdown {
    display: block;
  }

  .nav__dropdown-link {
    display: block;
    font-family: var(--font-family);
    font-size: var(--font-size-base);
    font-weight: 400;
    letter-spacing: 0;
    text-transform: lowercase;
    color: var(--color-text-nav);
    padding: 4px 0;
  }
</style>
