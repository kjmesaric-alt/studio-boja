---
// Slider arrows: prev/next between gallery images on the project page.
// This component is placed between the gallery column and the description column.
// It communicates with ImageGallery via custom events.
---

<div class="slider-arrows" id="slider-arrows">
  <button
    class="slider-arrow slider-arrow--left"
    id="slider-prev"
    aria-label="Previous image"
    hidden
  >&#8249;</button>
  <button
    class="slider-arrow slider-arrow--right"
    id="slider-next"
    aria-label="Next image"
  >&#8250;</button>
</div>

<script>
  const prevBtn = document.getElementById("slider-prev")!;
  const nextBtn = document.getElementById("slider-next")!;

  const gallery = document.getElementById("project-gallery");
  const items = gallery ? Array.from(gallery.querySelectorAll(".gallery__item")) : [];
  let currentIndex = 0;

  function scrollToImage(index: number) {
    if (index < 0 || index >= items.length) return;
    currentIndex = index;
    (items[currentIndex] as HTMLElement).scrollIntoView({ behavior: "smooth", block: "nearest" });
    (prevBtn as HTMLButtonElement).hidden = currentIndex === 0;
    (nextBtn as HTMLButtonElement).hidden = currentIndex === items.length - 1;
  }

  prevBtn.addEventListener("click", () => scrollToImage(currentIndex - 1));
  nextBtn.addEventListener("click", () => scrollToImage(currentIndex + 1));

  // Hide next if only one image
  if (items.length <= 1) {
    (nextBtn as HTMLButtonElement).hidden = true;
  }
</script>

<style>
  .slider-arrows {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-shrink: 0;
  }

  .slider-arrow {
    font-size: 32px;
    color: var(--color-arrow);
    cursor: pointer;
    line-height: 1;
    padding: 4px 8px;
    user-select: none;
  }

  .slider-arrow[hidden] {
    visibility: hidden;
    pointer-events: none;
  }
</style>
