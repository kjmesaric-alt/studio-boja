---
interface Props {
  images: string[];
  title: string;
  slug: string;
}

const { images, title } = Astro.props;
---

<div class="gallery" id="project-gallery">
  {
    images.map((src, i) => (
      <button
        class="gallery__item"
        aria-label={`View ${title} image ${i + 1}`}
        data-index={i}
        type="button"
      >
        <img src={src} alt={`${title} — image ${i + 1}`} loading={i === 0 ? "eager" : "lazy"} />
      </button>
    ))
  }
</div>

<!-- Overlay: covers viewport below nav; nav bar remains visible above -->
<div class="gallery-overlay" id="gallery-overlay" aria-modal="true" aria-hidden="true">
  <button class="gallery-overlay__arrow" id="overlay-prev" aria-label="Previous image" type="button">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <polyline points="15,5 8,12 15,19" />
    </svg>
  </button>
  <div class="gallery-overlay__stage">
    <img class="gallery-overlay__img" id="overlay-img" src="" alt="" />
  </div>
  <button class="gallery-overlay__arrow" id="overlay-next" aria-label="Next image" type="button">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <polyline points="9,5 16,12 9,19" />
    </svg>
  </button>
</div>

<script define:vars={{ images, title }}>
  const overlay = document.getElementById("gallery-overlay");
  const overlayImg = document.getElementById("overlay-img");
  const overlayPrev = document.getElementById("overlay-prev");
  const overlayNext = document.getElementById("overlay-next");
  const galleryItems = Array.from(document.querySelectorAll(".gallery__item[data-index]"));

  let currentIndex = 0;

  function updateArrows() {
    overlayPrev.style.visibility = currentIndex > 0 ? "visible" : "hidden";
    overlayNext.style.visibility = currentIndex < images.length - 1 ? "visible" : "hidden";
  }

  function openOverlay(index) {
    currentIndex = index;
    overlayImg.src = images[currentIndex];
    overlayImg.alt = `${title} \u2014 image ${currentIndex + 1}`;
    overlay.removeAttribute("aria-hidden");
    overlay.classList.add("is-open");
    document.body.style.overflow = "hidden";
    updateArrows();
  }

  function closeOverlay() {
    overlay.classList.remove("is-open");
    overlay.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  }

  function navigateTo(index) {
    if (index < 0 || index >= images.length) return;
    currentIndex = index;
    overlayImg.src = images[currentIndex];
    overlayImg.alt = `${title} \u2014 image ${currentIndex + 1}`;
    updateArrows();
  }

  galleryItems.forEach((btn) => {
    btn.addEventListener("click", () => {
      openOverlay(parseInt(btn.dataset.index, 10));
    });
  });

  overlayPrev.addEventListener("click", (e) => {
    e.stopPropagation();
    navigateTo(currentIndex - 1);
  });

  overlayNext.addEventListener("click", (e) => {
    e.stopPropagation();
    navigateTo(currentIndex + 1);
  });

  overlay.addEventListener("click", (e) => {
    if (e.target.closest(".gallery-overlay__img")) return;
    if (e.target.closest(".gallery-overlay__arrow")) return;
    closeOverlay();
  });

  document.addEventListener("keydown", (e) => {
    if (!overlay.classList.contains("is-open")) return;
    if (e.key === "Escape") { e.preventDefault(); closeOverlay(); }
    if (e.key === "ArrowLeft") { e.preventDefault(); navigateTo(currentIndex - 1); }
    if (e.key === "ArrowRight") { e.preventDefault(); navigateTo(currentIndex + 1); }
  });

  // Center first image at same vertical midpoint as the sticky info column (50vh)
  const firstImg = document.querySelector("#project-gallery .gallery__item img");
  if (firstImg) {
    function updateGalleryCentering() {
      const gallery = document.getElementById("project-gallery");
      if (!gallery) return;
      const navH = parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--nav-height")) || 80;
      const imgH = firstImg.offsetHeight;
      const topPad = Math.max(0, (window.innerHeight - navH - imgH) / 2);
      gallery.style.paddingTop = topPad + "px";
    }
    if (firstImg.complete && firstImg.naturalHeight > 0) {
      updateGalleryCentering();
    } else {
      firstImg.addEventListener("load", updateGalleryCentering, { once: true });
    }
    window.addEventListener("resize", updateGalleryCentering);
  }
</script>

<style>
  .gallery {
    width: clamp(320px, 34vw, 480px);
    display: flex;
    flex-direction: column;
    gap: var(--grid-gap);
    padding-bottom: 40px;
  }

  .gallery__item {
    cursor: pointer;
    display: block;
    width: 100%;
    flex-shrink: 0;
    background: none;
    border: none;
    padding: 0;
    text-align: left;
  }

  .gallery__item img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Overlay: starts below nav, covers rest of viewport */
  .gallery-overlay {
    display: none;
    position: fixed;
    top: var(--nav-height, 80px);
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-bg);
    z-index: 200;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 32px var(--page-side-padding);
  }

  .gallery-overlay.is-open {
    display: flex;
  }

  .gallery-overlay__stage {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    max-width: var(--lightbox-max-w);
  }

  .gallery-overlay__img {
    max-width: 100%;
    max-height: calc(100vh - var(--nav-height, 80px) - 64px);
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .gallery-overlay__arrow {
    flex-shrink: 0;
    color: var(--color-text-nav);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    cursor: pointer;
    background: transparent;
    border: none;
    padding: 0;
  }

  .gallery-overlay__arrow svg {
    width: 28px;
    height: 28px;
    stroke: currentColor;
    stroke-width: 1.8;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
