---
import BaseLayout from "../layouts/BaseLayout.astro";

// TODO: Update email and phone once confirmed.
// TODO: Update inquiry options once confirmed.
const inquiryOptions = [
  "residential design",
  "commercial design",
  "graphic design",
  "consultancy",
];
---

<BaseLayout title="contact — studio boja.">
  <main class="contact-page">
    <div class="contact-layout">
      <div class="contact-form-col">
        <p class="contact-heading">get in touch</p>
        <form class="contact-form" action="https://formspree.io/f/xqevgapo" method="POST">
          <label class="contact-form__row">
            <span class="contact-form__label">name</span>
            <input
              class="contact-form__input"
              type="text"
              name="name"
              required
              autocomplete="name"
            />
          </label>

          <label class="contact-form__row">
            <span class="contact-form__label">email</span>
            <input
              class="contact-form__input"
              type="email"
              name="email"
              required
              autocomplete="email"
            />
          </label>

          <label class="contact-form__row">
            <span class="contact-form__label">project type</span>
            <select class="contact-form__input contact-form__select" name="project_type" required>
              <option value="" disabled selected></option>
              {inquiryOptions.map((o) => <option value={o}>{o}</option>)}
            </select>
          </label>

          <label class="contact-form__row contact-form__row--textarea">
            <span class="contact-form__label">tell me about your project</span>
            <textarea
              class="contact-form__textarea"
              name="message"
              rows="5"
            ></textarea>
          </label>

          <button class="contact-form__submit" type="submit">send</button>
        </form>
      </div>

      <div class="contact-direct-col">
        <p class="contact-heading">or reach out directly</p>
        <!-- TODO: confirm email and phone -->
        <p class="contact-direct__item">hoj@boja.com</p>
        <p class="contact-direct__item">+31 6 45 179 256</p>
      </div>
    </div>
    <p class="contact-success" aria-live="polite">thank you, we will get back to you!</p>
  </main>
</BaseLayout>

<script>
  const contactForm = document.querySelector(".contact-form") as HTMLFormElement | null;
  const contactPage = document.querySelector(".contact-page") as HTMLElement | null;
  const submitBtn = contactForm?.querySelector(".contact-form__submit") as HTMLButtonElement | null;

  contactForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!contactForm) return;

    if (submitBtn) submitBtn.disabled = true;

    try {
      const response = await fetch("https://formspree.io/f/xqevgapo", {
        method: "POST",
        headers: { Accept: "application/json" },
        body: new FormData(contactForm),
      });

      if (response.ok) {
        contactPage?.classList.add("is-submitted");
      } else {
        if (submitBtn) submitBtn.disabled = false;
      }
    } catch {
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>

<style>
  .contact-page {
    min-height: calc(100vh - var(--nav-height, 80px));
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .contact-layout {
    display: flex;
    gap: 120px;
    padding: 0 var(--page-side-padding);
    align-items: baseline;
  }

  .contact-heading {
    font-family: var(--font-family);
    font-size: var(--font-size-base);
    font-weight: 700;
    text-transform: lowercase;
    color: var(--color-text-primary);
    margin-bottom: 24px;
  }

  .contact-success {
    display: none;
    font-family: var(--font-family);
    font-size: var(--font-size-base);
    font-weight: 500;
    text-transform: lowercase;
    color: var(--color-text-primary);
    text-align: center;
  }

  .contact-page.is-submitted {
    align-items: flex-start;
    padding-top: 320px;
  }

  .contact-page.is-submitted .contact-layout {
    display: none;
  }

  .contact-page.is-submitted .contact-success {
    display: block;
    margin-top: 0;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 280px;
  }

  .contact-form__row {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .contact-form__row--textarea {
    gap: 10px;
    margin-top: 2px;
  }

  .contact-form__label {
    font-family: var(--font-family);
    font-size: var(--font-size-base);
    font-weight: 400;
    text-transform: lowercase;
    color: var(--color-text-primary);
  }

  .contact-form__input,
  .contact-form__select,
  .contact-form__textarea {
    font-family: var(--font-family);
    font-size: var(--font-size-base);
    font-weight: 400;
    background: transparent;
    border: none;
    border-bottom: 0.75px solid var(--color-text-primary);
    padding: 3px 0;
    color: var(--color-text-primary);
    outline: none;
    appearance: none;
    width: 180px;
  }

  .contact-form__textarea {
    width: 100%;
    resize: none;
    border: 0.75px solid var(--color-text-primary);
    padding: 7px;
  }

  .contact-form__submit {
    align-self: flex-start;
    font-family: var(--font-family);
    font-size: var(--font-size-base);
    font-weight: 400;
    text-transform: lowercase;
    color: #ffffff;
    border: 0.75px solid color-mix(in srgb, var(--color-text-nav) 45%, white 55%);
    background-color: var(--color-text-nav);
    border-radius: 3px;
    padding: 6px 18px;
    cursor: pointer;
    margin-top: 8px;
    transition: transform 0.16s ease, filter 0.2s ease;
  }

  .contact-form__submit:hover {
    transform: scale(0.95);
    filter: saturate(1.05);
  }

  .contact-form__submit:active {
    transform: scale(0.95);
  }

  .contact-form-col {
    min-width: 280px;
  }

  .contact-direct__item {
    font-family: var(--font-family);
    font-size: var(--font-size-base);
    font-weight: 400;
    text-transform: lowercase;
    color: var(--color-text-primary);
    margin-bottom: 8px;
  }

  .contact-success {
    width: 100%;
    margin-top: 0;
  }
</style>
