---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectGrid from "../../components/ProjectGrid.astro";

const allProjects = await getCollection("projects");
const hospitality = allProjects.filter(
  (p) => p.data.category === "commercial" && p.data.subcategory === "hospitality"
);
const offices = allProjects.filter(
  (p) => p.data.category === "commercial" && p.data.subcategory === "offices"
);
const stores = allProjects.filter(
  (p) => p.data.category === "commercial" && p.data.subcategory === "stores"
);
---

<BaseLayout title="commercial — studio boja.">
  <main class="category-page">
    {
      hospitality.length > 0 && (
        <section class="subsection">
          <div class="subsection__header">
            <p class="section-title">commercial</p>
            <p class="section-subtitle">hospitality</p>
          </div>
          <ProjectGrid projects={hospitality} />
        </section>
      )
    }

    {
      offices.length > 0 && (
        <section class="subsection">
          <div class="subsection__header">
            <p class="section-title">commercial</p>
            <p class="section-subtitle">offices</p>
          </div>
          <ProjectGrid projects={offices} />
        </section>
      )
    }

    {
      stores.length > 0 && (
        <section class="subsection">
          <div class="subsection__header">
            <p class="section-title">commercial</p>
            <p class="section-subtitle">stores</p>
          </div>
          <ProjectGrid projects={stores} />
        </section>
      )
    }
  </main>
</BaseLayout>

<style>
  .category-page {
    padding-bottom: 80px;
  }

  .subsection {
    margin-bottom: 64px;
  }

  .subsection__header {
    padding: 24px var(--page-side-padding) 16px;
  }

  .section-title {
    font-family: var(--font-family);
    font-size: var(--font-size-base);
    font-weight: 700;
    text-transform: lowercase;
    color: var(--color-text-primary);
  }

  .section-subtitle {
    font-family: var(--font-family);
    font-size: var(--font-size-base);
    font-weight: 400;
    text-transform: lowercase;
    color: var(--color-text-primary);
  }
</style>
