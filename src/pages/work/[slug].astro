---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ImageGallery from "../../components/ImageGallery.astro";
import SliderArrows from "../../components/SliderArrows.astro";
import { getProjectImages, entrySlug } from "../../lib/projects";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((p) => {
    const slug = entrySlug(p.id);
    return { params: { slug }, props: { project: p } };
  });
}

const { project } = Astro.props;
const { slug } = Astro.params;
const { Content } = await render(project);
const images = getProjectImages(slug);
---

<BaseLayout title={`${project.data.title} — studio boja.`}>
  <main class="project-page">
    <div class="project-page__header">
      <p class="project-page__category">
        {project.data.category}{project.data.subcategory ? ` design` : ""}
      </p>
    </div>

    <div class="project-page__body">
      <ImageGallery images={images} title={project.data.title} />
      <SliderArrows />
      <div class="project-page__info">
        <h1 class="project-page__title">{project.data.title}</h1>
        <div class="project-page__description">
          <Content />
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .project-page {
    padding-bottom: 80px;
  }

  .project-page__header {
    padding: 24px var(--page-side-padding) 16px;
  }

  .project-page__category {
    font-family: var(--font-family);
    font-size: var(--font-size-base);
    font-weight: 700;
    text-transform: lowercase;
    color: var(--color-text-primary);
  }

  .project-page__body {
    display: flex;
    align-items: flex-start;
    gap: 0;
    padding: 0 var(--page-side-padding);
  }

  .project-page__info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-self: center;
    padding-left: 48px;
    max-width: 340px;
  }

  .project-page__title {
    font-family: var(--font-family);
    font-size: var(--font-size-base);
    font-weight: 700;
    text-transform: lowercase;
    color: var(--color-text-primary);
    margin-bottom: 16px;
  }

  .project-page__description {
    font-family: var(--font-family);
    font-size: var(--font-size-base);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-text-primary);
  }

  .project-page__description p {
    margin-bottom: 12px;
  }

  .project-page__description p:last-child {
    margin-bottom: 0;
  }
</style>
