---
import BaseLayout from "../layouts/BaseLayout.astro";

const services = [
  {
    title: "INTERIOR DESIGN",
    description:
      "Full service interior design for residential and commercial spaces. From initial concept to final installation, with different levels of involvement depending on what the project needs. Either focusing on concept creation, a complete spatial plan with technical drawings and furniture procurement, or full project management from start to finish. Get in touch and we'll find the right fit.",
    image: "/services/interiordesign.svg",
  },
  {
    title: "PRE PURCHASE CONSULTATION",
    description:
      "Support for when you're considering buying a renovation property. We look at floor plans to understand what's possible, from minor layout changes to complete restructuring in order to create more rooms. We'll give you a clear sense of what works, what doesn't, and where the real potential sits. It's about making confident decisions before you commit.",
    image: "/services/realestate.svg",
  },
  {
    title: "CONSULTATION",
    description:
      "Short, focused sessions to help you move forward. Bring your questions, whether it's layout, materials, or a part of your space where something's off. You get direct, honest input and clear next steps. Simple, practical, and to the point.",
    image: "/services/consult.svg",
  },
  {
    title: "SECOND HAND FURNITURE SOURCING",
    description:
      "Based on your space, studio boja. sources items that fit both function and feel. We scout for the right pieces through secondhand markets, vintage shops and unexpected places. It's a more thoughtful, sustainable approach that brings one of a kind pieces full of history.",
    image: "/services/furniture.svg",
  },
];
---

<BaseLayout title="services — studio boja.">
  <main class="services-page">
    <div class="services-grid">
      {
        services.map((s) => (
          <div class="service">
            <img
              class="service__img"
              src={s.image}
              alt={s.title}
              loading="lazy"
            />
            <p class="service__description">
              <span class="service__title">{s.title}</span>
              {" " + s.description}
            </p>
          </div>
        ))
      }
    </div>
  </main>
</BaseLayout>

<style>
  .services-page {
    min-height: calc(100vh - var(--nav-height, 80px));
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .services-grid {
    display: flex;
    gap: var(--grid-gap);
    padding: 0 var(--page-side-padding);
    align-items: flex-start;
  }

  .service {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .service__img {
    width: 100%;
    aspect-ratio: 480 / 500;
    object-fit: contain;
  }

  .service__description {
    font-family: var(--font-family);
    font-size: var(--font-size-base);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-text-primary);
  }

  .service__title {
    font-weight: 500;
  }
</style>
