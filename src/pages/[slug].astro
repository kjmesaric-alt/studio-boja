---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ImageGallery from "../components/ImageGallery.astro";
import { getProjectImages, entrySlug } from "../lib/projects";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((p) => {
    const slug = entrySlug(p.id);
    return { params: { slug }, props: { project: p } };
  });
}

const { project } = Astro.props;
const { slug } = Astro.params;
const { Content } = await render(project);
const images = getProjectImages(slug);
---

<BaseLayout title={`${project.data.title} — studio boja.`}>
  <main class="project-page">
    <div class="project-page__body">
      <div class="project-page__gallery-col">
        <ImageGallery images={images} title={project.data.title} slug={slug} />
      </div>
      <div class="project-page__info">
        <h1 class="project-page__title">{project.data.title}</h1>
        <div class="project-page__description">
          <Content />
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .project-page {
    height: calc(100vh - var(--nav-height, 80px));
    overflow: hidden;
    overscroll-behavior: none;
  }

  .project-page__body {
    height: 100%;
    display: flex;
    align-items: stretch;
    justify-content: center;
    gap: 64px;
    padding: 0 var(--page-side-padding);
  }

  .project-page__gallery-col {
    flex-shrink: 0;
    overflow-y: auto;
    overscroll-behavior: none;
    scrollbar-width: none;
  }

  .project-page__gallery-col::-webkit-scrollbar {
    display: none;
  }

  .project-page__info {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 360px;
  }

  .project-page__title {
    font-family: var(--font-family);
    font-size: var(--font-size-title);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 16px;
  }

  .project-page__description {
    font-family: var(--font-family);
    font-size: var(--font-size-base);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-text-primary);
  }

  .project-page__description p {
    margin-bottom: 12px;
  }

  .project-page__description p:last-child {
    margin-bottom: 0;
  }
</style>
